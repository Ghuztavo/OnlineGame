<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements"
    xsi="http://www.w3.org/2001/XMLSchema-instance"
    engine="UnityEngine.UIElements" editor="UnityEditor.UIElements"
    noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd"
    editor-extension-mode="False">

    <Style src="project://database/Assets/UI/LobbyUI.uss"/>

    <!-- Root backdrop -->
    <ui:VisualElement name="root" class="root-bg">

        <!-- Centred card -->
        <ui:VisualElement name="lobby-container" class="lobby-card">

            <!-- Logo / Title -->
            <ui:Label text="ONLINE GAME" class="game-title"/>
            <ui:Label text="LOBBY" class="lobby-subtitle"/>

            <ui:VisualElement class="divider"/>

            <!-- Nickname -->
            <ui:Label text="NICKNAME" class="field-label"/>
            <ui:TextField name="nickname-field" class="input-field"
                placeholder-text="Enter your name…" max-length="32"/>

            <!-- Session name -->
            <ui:Label text="SESSION NAME" class="field-label"/>
            <ui:TextField name="session-field" class="input-field"
                placeholder-text="e.g. my-room" max-length="32"/>

            <ui:VisualElement class="button-row">
                <ui:Button name="host-button" text="HOST" class="btn btn-host"/>
                <ui:Button name="join-button" text="JOIN" class="btn btn-join"/>
            </ui:VisualElement>

            <!-- Status message -->
            <ui:Label name="status-label" text="" class="status-label"/>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
