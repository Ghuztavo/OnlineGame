/* ──────────────────────────────────────────────────────────────────────────
   LobbyUI.uss  —  Styling for the Fusion FPS Lobby Screen
   Uses USS (Unity Style Sheets), the UI Toolkit equivalent of CSS.
   ────────────────────────────────────────────────────────────────────────── */

/* ── Variables (USS custom properties) ──────────────────────────────────── */
:root {
    --color-bg-deep:   #0a0c14;
    --color-bg-card:   rgba(18, 22, 38, 0.95);
    --color-accent:    #4f8cff;
    --color-accent-2:  #7b5cf0;
    --color-host:      #4f8cff;
    --color-join:      #7b5cf0;
    --color-text:      #e8eaf6;
    --color-muted:     #8890b0;
    --color-border:    rgba(79, 140, 255, 0.25);
    --color-danger:    #ff6b6b;
    --radius-card:     18px;
    --radius-field:    10px;
    --radius-btn:      10px;
}

/* ── Full-screen backdrop with radial gradient ───────────────────────────── */
.root-bg {
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: #0a0c14;
}

/* ── Frosted-glass card ──────────────────────────────────────────────────── */
.lobby-card {
    width: 420px;
    background-color: rgba(18, 22, 38, 0.96);
    border-radius: 18px;
    border-width: 1px;
    border-color: rgba(79, 140, 255, 0.28);
    padding: 42px 40px 36px 40px;
    flex-direction: column;
    align-items: stretch;

    /* Subtle drop shadow via margin trick (USS has no box-shadow) */
    margin-top: 0;
    margin-bottom: 0;
}

/* ── Title ───────────────────────────────────────────────────────────────── */
.game-title {
    font-size: 32px;
    color: #4f8cff;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    letter-spacing: 6px;
    margin-bottom: 2px;
}

.lobby-subtitle {
    font-size: 13px;
    color: #8890b0;
    -unity-text-align: upper-center;
    letter-spacing: 8px;
    margin-bottom: 0;
}

/* ── Divider ─────────────────────────────────────────────────────────────── */
.divider {
    height: 1px;
    background-color: rgba(79, 140, 255, 0.2);
    margin-top: 20px;
    margin-bottom: 24px;
}

/* ── Field labels ────────────────────────────────────────────────────────── */
.field-label {
    font-size: 10px;
    color: #8890b0;
    letter-spacing: 3px;
    -unity-font-style: bold;
    margin-bottom: 6px;
    margin-top: 4px;
}

/* ── Text fields ─────────────────────────────────────────────────────────── */
.input-field {
    height: 44px;
    font-size: 15px;
    color: #e8eaf6;
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(79, 140, 255, 0.3);
    padding-left: 14px;
    padding-right: 14px;
    margin-bottom: 18px;
}

.input-field:focus {
    border-color: #4f8cff;
    background-color: rgba(79, 140, 255, 0.06);
}

/* Inner text element */
.input-field > .unity-text-field__input {
    color: #e8eaf6;
    font-size: 15px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

/* ── Button row ──────────────────────────────────────────────────────────── */
.button-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 8px;
    margin-bottom: 18px;
}

/* ── Shared button base ──────────────────────────────────────────────────── */
.btn {
    flex-grow: 1;
    height: 48px;
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    border-radius: 10px;
    border-width: 0;
    cursor: link;
    transition-duration: 0.15s;
    transition-property: background-color, scale;
}

.btn:hover {
    scale: 1.03 1.03;
}

.btn:active {
    scale: 0.97 0.97;
}

/* ── Host button (blue) ──────────────────────────────────────────────────── */
.btn-host {
    background-color: #4f8cff;
    color: #ffffff;
    margin-right: 8px;
}

.btn-host:hover {
    background-color: #6fa3ff;
}

.btn-host:disabled {
    background-color: rgba(79, 140, 255, 0.3);
    color: rgba(255, 255, 255, 0.4);
}

/* ── Join button (purple) ────────────────────────────────────────────────── */
.btn-join {
    background-color: #7b5cf0;
    color: #ffffff;
    margin-left: 8px;
}

.btn-join:hover {
    background-color: #9b80f5;
}

.btn-join:disabled {
    background-color: rgba(123, 92, 240, 0.3);
    color: rgba(255, 255, 255, 0.4);
}

/* ── Status label ────────────────────────────────────────────────────────── */
.status-label {
    font-size: 12px;
    color: #8890b0;
    -unity-text-align: upper-center;
    white-space: normal;
    margin-top: 4px;
}
